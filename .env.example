# 应用配置
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=t3_program

# 验证码存储后端（memory 或 redis）
OTP_STORE_BACKEND=memory

# Redis 配置（OTP_STORE_BACKEND=redis 时生效）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 配置（预留）
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d

# 短信服务配置（阿里云 SMS）
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# 邮件 SMTP（阿里云 DirectMail）
# 留空则自动进入 Mock 模式，验证码会输出到后端日志
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 阿里云 OSS 对象存储（头像、封面等文件上传）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=oss-cn-hangzhou
OSS_CUSTOM_DOMAIN=

# 高德地图 Web 服务
AMAP_KEY=